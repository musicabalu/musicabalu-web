generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String       @id @default(cuid())
  name          String?
  email         String?      @unique
  emailVerified DateTime?
  image         String?
  role          String       @default("familia")
  stripeId      String?      @unique
  hasActiveSub  Boolean      @default(false)
  accounts      Account[]
  activityLogs  ActivityLog[]
  enrollments   Enrollment[]
  orders        Order[]
  sessions      Session[]
}

model Order {
  id              String   @id @default(cuid())
  userId          String
  stripeSessionId String   @unique
  productId       String
  productName     String
  productType     String
  amountTotal     Int
  currency        String   @default("eur")
  status          String
  shippingData    String?
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Product {
  id            String   @id @default(cuid())
  name          String
  description   String
  price         Int
  type          String
  imageUrl      String?
  stripePriceId String?  @unique
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Activity {
  id           String   @id @default(cuid())
  titulo       String
  edades       String
  categoria    String
  descripcion  String
  libro_origen String
  isFree       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ContentPill {
  id                  String   @id @default(cuid())
  tipo                String
  teoria_mlt          String
  aplicacion_practica String
  libro_origen        String
  isFree              Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Group {
  id          String       @id @default(cuid())
  name        String
  schedule    String
  capacity    Int          @default(15)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  enrollments Enrollment[]
}

model Enrollment {
  id               String   @id @default(cuid())
  childName        String
  childBirthDate   String?
  parentName       String
  phone            String
  email            String
  paymentMethod    String
  paymentFrequency String?
  status           String   @default("pending")
  attendanceData   String?  @default("{}")
  groupId          String
  userId           String?
  acceptedTerms    Boolean  @default(false)
  acceptedComms    Boolean  @default(false)
  notes            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  group            Group    @relation(fields: [groupId], references: [id])
  user             User?    @relation(fields: [userId], references: [id])
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
